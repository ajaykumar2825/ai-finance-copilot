# =============================================================================
# AI Finance Copilot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values. Never commit .env to version
# control. All values below are placeholders — replace with real credentials.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (e.g. postgresql://user:pass@host:5432/dbname)
DATABASE_URL=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard (Settings → API)
SUPABASE_URL=
# Public (anon) key — safe for client-side use
SUPABASE_ANON_KEY=
# Service role key — server-side only, bypasses RLS
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM / AI Providers ───────────────────────────────────────────────────────
# OpenAI — get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini — get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Anthropic — get key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Embedding Configuration ──────────────────────────────────────────────────
# Which provider to use for generating embeddings: openai | gemini | local
EMBEDDING_PROVIDER=

# ── LLM Configuration ────────────────────────────────────────────────────────
# Which provider to use for chat/completion: openai | gemini | anthropic
LLM_PROVIDER=
# Model identifier (e.g. gpt-4o, gemini-2.0-flash, claude-sonnet-4-20250514)
LLM_MODEL=

# ── Authentication ────────────────────────────────────────────────────────────
# Secret used to sign short-lived JWT access tokens (min 32 chars)
JWT_SECRET=
# Secret used to sign long-lived refresh tokens (min 32 chars)
JWT_REFRESH_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. http://localhost:3000,https://example.com)
CORS_ORIGINS=

# ── Public (client-side) environment variables ────────────────────────────────
# Base URL of the API server (e.g. http://localhost:8080)
NEXT_PUBLIC_API_URL=
# Supabase URL exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key exposed to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Storage ───────────────────────────────────────────────────────────────────
# Supabase Storage bucket name for file uploads (e.g. receipts, documents)
STORAGE_BUCKET=
